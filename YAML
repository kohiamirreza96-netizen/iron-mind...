name: Build APK
on:
  workflow_dispatch:
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Arrange files
        run: |
          mkdir -p www/fonts assets
          if [ -f index.html ]; then mv index.html www/index.html; fi
          if [ -f Vazirmatn.ttf ]; then mv Vazirmatn.ttf www/fonts/Vazirmatn.ttf; fi
          for f in icon-background.png icon-foreground.png icon-only.png splash.png splash-dark.png; do
            if [ -f "$f" ]; then mv "$f" assets/; fi
          done
          ls -R www assets
      - uses: actions/setup-node@v4
        with:
          node-version: 20
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17
      - name: Install
        run: npm install
      - name: Add Android platform
        run: npx cap add android
      - name: Generate icons and splash
        run: npx capacitor-assets generate --android --iconBackgroundColor '#050b0a' --iconBackgroundColorDark '#050b0a' --splashBackgroundColor '#050b0a' --splashBackgroundColorDark '#050b0a'
      - name: Sync web files
        run: npx cap sync android
      - name: Build debug APK
        working-directory: android
        run: |
          chmod +x gradlew
          ./gradlew assembleDebug
      - uses: actions/upload-artifact@v4
        with:
          name: IronMind-APK
          path: android/app/build/outputs/apk/debug/app-debug.apk
